@startuml fig_casos_uso
!include estilo.iuml
left to right direction

actor "Usuario" as U
actor "Cámara" <<dispositivo>> as Cam

rectangle "EcoVision" {
  usecase "Seleccionar modo\n(real o simulación)" as UC1
  usecase "Reconocer residuo\npresentado" as UC2
  usecase "Mostrar orientación\nde disposición" as UC3
  usecase "Avisar cámara\nno disponible" as UC4
  usecase "Finalizar sesión" as UC5
}

U -- UC1
U -- UC2
U -- UC5
UC2 -- Cam
UC2 ..> UC3 : <<include>>
UC4 ..> UC2 : <<extend>>

@enduml
